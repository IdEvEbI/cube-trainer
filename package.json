{
  "name": "cube-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "魔方公式练习、打乱与计时工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test src/modules/timer/timer.test.ts src/modules/formula/formulas.test.ts src/modules/cube/cube.test.ts src/modules/scramble/scramble.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint \"**/*.md\"",
    "lint:md:fix": "markdownlint --fix \"**/*.md\"",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "cubing": "^0.66.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "markdownlint-cli": "0.45.0",
    "prettier": "3.6.2",
    "prettier-plugin-zh": "0.7.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
